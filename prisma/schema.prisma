datasource db {
  provider = "sqlite" // для роста — заменить на "postgresql" и указать DATABASE_URL
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String         @id @default(uuid())
  email         String?        @unique // теперь основная привязка аккаунта
  deviceId      String?        @unique // сохранено для обратной совместимости с уже выданными анонимными токенами
  createdAt     DateTime       @default(now())
  subscriptions Subscription[]
}

model OtpCode {
  id        String   @id @default(uuid())
  email     String
  code      String   // 6 цифр, храним как есть — короткий TTL делает это приемлемым для MVP
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, code])
}

model Subscription {
  id                String   @id @default(uuid()) // серверный remoteId
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  price             Float
  currency          String   @default("RUB")
  billingCycle      String   // WEEKLY | MONTHLY | YEARLY | CUSTOM_DAYS
  customIntervalDays Int?    // используется только при billingCycle = CUSTOM_DAYS
  nextPaymentDate   BigInt   // epoch millis
  category          String
  notifyDaysBefore  Int      @default(3)
  isArchived        Boolean  @default(false)
  promoCode         String?
  isDeleted         Boolean  @default(false) // soft delete для корректной синхронизации между устройствами
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  @@index([userId, updatedAt])
}
