DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string-before-deploying"
PORT=3000

# Resend — отправка OTP-кодов на email. Без ключа коды только логируются
# в консоль (режим для локальной разработки). Получить ключ: resend.com → API Keys.
RESEND_API_KEY=
# Адрес отправителя. onboarding@resend.dev работает сразу без верификации домена
# (подходит для теста), но письма с него иногда попадают в спам у получателей.
# Перед реальным запуском стоит верифицировать свой домен в Resend и указать
# что-то вроде noreply@yourdomain.ru
EMAIL_FROM=onboarding@resend.dev
